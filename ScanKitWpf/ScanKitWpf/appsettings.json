{
  "Title": "A巷道相机识别程序V1.0",
  "ImgCenter": {
    "Rotate_Center_X": 2700,
    "Rotate_Center_Y": 2000
  },
  "Camera": {
    //"Name": "DA1462603",
    "Name": "DA2137386",
    //"Name": "L05837875",
    "ExposeTime": 8000,
    "Scale": 0.5,
    "Mask": 3,
    "Factor": 2
  },
  "PicSaveConfig": {
    "PicType": "jpg",
    "PicPath": "D:/application/pic/A"
  },
  "ScanCodeConfig": [
    {
      "CodeType": "Code 128",
      "IsChecked": "true"
    },
    {
      "CodeType": "Code 39",
      "IsChecked": "true"
    },
    {
      "CodeType": "Code 93",
      "IsChecked": "true"
    },
    {
      "CodeType": "QR Code",
      "IsChecked": "true"
    },
    {
      "CodeType": "Data Matrix ECC 200",
      "IsChecked": "true"
    },
    {
      "codeType": "PDF417",
      "IsChecked": "false"
    }
  ],
  "ServerIp": "127.0.0.1",
  "ServerPort": 5555,
  "Trigger": {
    "TriggerMode": "Off",
    "TriggerSource": "Software",
    "TriggerCommand": "RUN"
  },
  "NLog": {
    "autoReload": true,
    "throwConfigExceptions": true,
    "internalLogLevel": "Info",
    "internalLogFile": "${basedir}/internal-nlog.txt",
    "extensions": [
      { "assembly": "NLog.Extensions.Logging" },
    ],
    "variables": {
      "LogFolder": "${basedir}/logs",
      "LogName": "${event-properties:filename}${when:when='${event-properties:filename}'=='':else=_}${shortdate}.log"
    },
    //"time": {
    //  "type": "AccurateUTC"
    //},
    "default-wrapper": {
      "type": "AsyncWrapper",
      "overflowAction": "Block"
    },
    "targets": {
      "all-file": {
        "type": "File",
        "fileName": "${LogFolder}/${LogName}",
        "archiveEvery": "Day",
        "archiveNumbering": "Rolling",
        "maxArchiveFiles": "1",
        "layout": {
          "type": "JsonLayout",
          "Attributes": [
            {
              "name": "timestamp",
              "layout": "${date:format=o}"
            },
            {
              "name": "level",
              "layout": "${level}"
            },
            {
              "name": "logger",
              "layout": "${logger}"
            },
            {
              "name": "message",
              "layout": "${message:raw=true}"
            },
            {
              "name": "properties",
              "encode": false,
              "layout": {
                "type": "JsonLayout",
                "includeallproperties": "true"
              }
            }
          ]
        }
      }
    },
    "rules": [
      {
        "logger": "*",
        "minLevel": "Info",
        "writeTo": "all-file"
      }
    ]
  }
}
